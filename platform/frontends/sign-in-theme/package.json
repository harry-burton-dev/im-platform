{
  "name": "@augur/sign-in-theme",
  "version": "0.1.1",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "description": "AUGUR's sign-in and email theme for Keycloak (ADR 0041), built with Keycloakify from Common's tokens and parts. Shipped as a jar in AUGUR's Keycloak image.",
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "jar": "node scripts/email-layout.mjs && vite build && keycloakify build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@augur/kit-common": "npm:@harry-burton-dev/augur-kit-common@^0.2.0",
    "@fontsource/jost": "5.2.8",
    "keycloakify": "11.16.4",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "happy-dom": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
