{
  "name": "@augur/shell",
  "version": "0.20.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "description": "The shell host: wraps ui-shell, loads apps from the registry manifest, mounts the current app and routes intents.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build -c vite.shared.config.ts && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "preview": "vite preview",
    "build:shared": "vite build -c vite.shared.config.ts"
  },
  "dependencies": {
    "@augur/app-kit": "npm:@harry-burton-dev/augur-app-kit@^0.11.0",
    "@augur/kit-common": "npm:@harry-burton-dev/augur-kit-common@^0.9.0",
    "@augur/mfe-sdk": "workspace:*",
    "@augur/shell-kit": "npm:@harry-burton-dev/augur-shell-kit@^0.7.1",
    "@grafana/faro-transport-otlp-http": "^2.13.0",
    "@grafana/faro-web-sdk": "^2.13.0",
    "@grafana/faro-web-tracing": "^2.13.0",
    "oidc-client-ts": "^3.5.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "semver": "catalog:"
  },
  "devDependencies": {
    "@augur/kit-bundle": "npm:@harry-burton-dev/augur-kit-bundle@0.5.6",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/semver": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "happy-dom": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
