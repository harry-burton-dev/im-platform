{
  "name": "@augur/service-kit",
  "version": "0.18.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "description": "What a backend service needs to know who is calling: the caller the gateway verified, carried in request headers.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./telemetry": {
      "types": "./dist/telemetry.d.ts",
      "default": "./dist/telemetry.js"
    },
    "./mail": {
      "types": "./dist/mail.d.ts",
      "default": "./dist/mail.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "@types/react": "catalog:",
    "fastify": "catalog:",
    "pg": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "@dbos-inc/dbos-sdk": "^5.4.0",
    "@opentelemetry/api": "catalog:",
    "@opentelemetry/instrumentation": "^0.300.0",
    "@opentelemetry/instrumentation-http": "^0.300.0",
    "@opentelemetry/instrumentation-pg": "^0.77.0",
    "@opentelemetry/instrumentation-pino": "^0.70.0",
    "@opentelemetry/instrumentation-undici": "^0.34.0",
    "@opentelemetry/sdk-node": "^0.300.0",
    "@react-email/render": "^2.2.0",
    "jose": "catalog:",
    "nodemailer": "^10.3.1",
    "pino": "^10.4.0",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "peerDependencies": {
    "fastify": "^5.6.0"
  }
