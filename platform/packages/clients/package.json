{
  "name": "@augur/clients",
  "version": "0.1.1",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "description": "Typed clients for AUGUR's platform APIs, generated from contracts/*.openapi.yaml: one factory per service, called through the gateway.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "build": "node scripts/generate.mjs && tsc -p tsconfig.json",
    "typecheck": "node scripts/generate.mjs && tsc -p tsconfig.json --noEmit",
    "test": "node scripts/generate.mjs && vitest run"
  },
  "dependencies": {
    "openapi-fetch": "^0.17.0"
  },
  "devDependencies": {
    "openapi-typescript": "^7.13.0",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "yaml": "catalog:"
  }
}
